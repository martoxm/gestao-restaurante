{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "troque-este-valor-por-um-segredo-bem-longo-e-aleatorio-antes-de-usar-em-producao",
    "Issuer": "GestaoRestauranteApi",
    "Audience": "GestaoRestauranteClient",
    "ExpirationMinutes": 15
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:3000"
  },
  "LimiteRequisicoes": {
    "GeralPorMinuto": 300,
    "AutenticacaoPorMinuto": 20
  },
  "ReverseProxy": {
    "Routes": {
      "identidade-auth": {
        "ClusterId": "identidade",
        "Order": 1,
        "RateLimiterPolicy": "autenticacao",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/identidade/api/v1/auth/{**resto}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identidade"
          }
        ]
      },
      "identidade": {
        "ClusterId": "identidade",
        "Order": 2,
        "RateLimiterPolicy": "geral",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/identidade/{**resto}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identidade"
          }
        ]
      },
      "estoque": {
        "ClusterId": "estoque",
        "Order": 2,
        "RateLimiterPolicy": "geral",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/estoque/{**resto}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/estoque"
          }
        ]
      },
      "vendas": {
        "ClusterId": "vendas",
        "Order": 2,
        "RateLimiterPolicy": "geral",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/vendas/{**resto}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/vendas"
          }
        ]
      },
      "pagamentos-assinaturas": {
        "ClusterId": "pagamentos",
        "Order": 2,
        "RateLimiterPolicy": "geral",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/pagamentos/api/v1/assinaturas/{**resto}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/pagamentos"
          }
        ]
      }
    },
    "Clusters": {
      "identidade": {
        "Destinations": {
          "principal": {
            "Address": "https://localhost:7010/"
          }
        }
      },
      "estoque": {
        "Destinations": {
          "principal": {
            "Address": "https://localhost:7008/"
          }
        }
      },
      "vendas": {
        "Destinations": {
          "principal": {
            "Address": "https://localhost:7012/"
          }
        }
      },
      "pagamentos": {
        "Destinations": {
          "principal": {
            "Address": "https://localhost:7014/"
          }
        }
      }
    }
  }
}
