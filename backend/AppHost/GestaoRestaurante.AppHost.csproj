<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <!-- O AppHost do Aspire: é o projeto que você roda (F5) pra subir as quatro
       APIs de uma vez e abrir o dashboard com os logs de todas juntas. Ele não
       vai pra produção; é só pra rodar no dia a dia. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>3b1f6c2e-8d4a-4f7b-9c1e-5a2d7e9f0b43</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\services\Identidade\Api\GestaoRestaurante.Identidade.Api.csproj" />
    <ProjectReference Include="..\services\Estoque\Api\GestaoRestaurante.Api.csproj" />
    <ProjectReference Include="..\services\Vendas\Api\GestaoRestaurante.Vendas.Api.csproj" />
    <ProjectReference Include="..\services\Pagamentos\Api\GestaoRestaurante.Pagamentos.Api.csproj" />
    <ProjectReference Include="..\services\Email\Api\GestaoRestaurante.Email.Api.csproj" />
    <ProjectReference Include="..\services\Gateway\Api\GestaoRestaurante.Gateway.Api.csproj" />
  </ItemGroup>

</Project>
